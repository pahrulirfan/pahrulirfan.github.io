# Salin file ini menjadi .env, lalu sesuaikan nilainya.
# File .env tidak ikut ke Git.

# Alamat database: mysql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
# MySQL tanpa password:
DATABASE_URL="mysql://root@localhost:3306/api_mahasiswa"
# MySQL dengan password (hapus tanda # di bawah, buang baris di atas):
# DATABASE_URL="mysql://root:passwordku@localhost:3306/api_mahasiswa"

# Kunci penanda token JWT. Buat yang acak:
#   node -p "require('node:crypto').randomBytes(32).toString('hex')"
JWT_SECRET=ganti-dengan-hasil-perintah-di-atas

# Port server (bawaan 3000)
PORT=3000

# Asal front end yang diizinkan CORS (Vue/React dari Vite berjalan di 5173)
CORS_ORIGIN=http://localhost:5173

# Batas percobaan login yang GAGAL per IP dalam 15 menit (bawaan 5)
LOGIN_MAX_GAGAL=5
